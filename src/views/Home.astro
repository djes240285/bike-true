---
import Base from '../layouts/Base.astro';
import SampleMeter from '../components/SampleMeter';
import Support from '../components/Support';
import { dict, type Locale } from '../i18n';
import { pathFor } from '../lib/paths';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict[locale];
const angles = ['knee', 'back', 'arm', 'hip'] as const;
---

<Base locale={locale} path="/">
  <div class="print-home">
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">{t.home.kicker}</p>
      <h1>{t.home.title}</h1>
      <p class="lead">{t.home.lead}</p>
      <div class="actions">
        <a class="button" href={pathFor(locale, '/analyze')}>{t.home.primary}</a>
        <a class="button ghost" href={pathFor(locale, '/how-to-shoot')}>{t.home.secondary}</a>
      </div>
      <ul class="proof">
        {t.home.proof.map((item) => <li>{item}</li>)}
      </ul>
      <SampleMeter client:load locale={locale} />
    </div>
    <aside class="hero-visual" aria-hidden="true">
      <canvas class="hero-plate"></canvas>
      <video
        class="hero-source"
        src="/motion/fit-story.mp4"
        poster="/motion/print-rider.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>
    </aside>
    <script is:inline>
      document.querySelectorAll('.print-home .hero-visual').forEach((visual) => {
        const video = visual.querySelector('.hero-source');
        const canvas = visual.querySelector('.hero-plate');
        const ctx = canvas.getContext('2d');
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const paint = () => {
          if (video.readyState < 2) return;
          const w = canvas.clientWidth;
          const h = canvas.clientHeight;
          if (!w || !h) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const pw = Math.round(w * dpr);
          const ph = Math.round(h * dpr);
          if (canvas.width !== pw || canvas.height !== ph) {
            canvas.width = pw;
            canvas.height = ph;
          }
          ctx.drawImage(video, 0, 0, pw, ph);
        };
        const tick = () => {
          paint();
          if (!reduced && !video.paused && !video.ended) requestAnimationFrame(tick);
        };
        const start = () => {
          if (reduced) {
            video.removeAttribute('autoplay');
            video.pause();
            paint();
            return;
          }
          video.play().catch(() => {});
          tick();
        };
        if (video.readyState >= 2) start();
        else video.addEventListener('loadeddata', start, { once: true });
      });
    </script>
  </section>

  <section class="band band-white" data-reveal>
    <div class="band-inner">
      <header class="section-head">
        <p class="kicker">{t.home.benefitsKicker}</p>
        <h2>{t.home.benefitsTitle}</h2>
      </header>
      <div class="benefits">
        {t.home.benefits.map((item, index) => (
          <article class="benefit">
            <span class="benefit-icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor" d="M12 20.2s-6.4-4-6.4-8.8A3.7 3.7 0 0 1 12 8.2a3.7 3.7 0 0 1 6.4 3.2c0 4.8-6.4 8.8-6.4 8.8Z" />
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor" d="M13 2 4.2 13.6h6.2L9.2 22 19.8 10H13.4L13 2Z" />
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24">
                  <circle cx="6.2" cy="17.2" r="2.1" fill="currentColor" />
                  <path d="M8.2 16.2c2.6-.8 4.2-3.2 5.2-5.6.9-2.2 2.2-3.6 4.8-4.6" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
                  <path d="M14.8 5.2 18.8 6l-2.4 3.4" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="band-inner">
      <header class="section-head">
        <p class="kicker">{t.home.stepsKicker}</p>
        <h2>{t.home.stepsTitle}</h2>
      </header>
      <ol class="steps">
        {t.home.steps.map((step, index) => (
          <li class="step">
            <em>0{index + 1}</em>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="band-inner">
      <header class="section-head">
        <p class="kicker">{t.home.anglesKicker}</p>
        <h2>{t.home.anglesTitle}</h2>
        <p class="section-lead">{t.home.anglesLead}</p>
      </header>
      <div class="angle-grid">
        {angles.map((key) => (
          <article class="angle">
            <em>{t.angles[key].where}</em>
            <strong>{t.angles[key].label}</strong>
            <b>{t.angles[key].range}</b>
          </article>
        ))}
      </div>
      <p class="note">{t.home.anglesNote}</p>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="band-inner faq-teaser">
      <header class="section-head">
        <p class="kicker">{t.home.faqKicker}</p>
        <h2>{t.home.faqTitle}</h2>
        <a class="text-link" href={pathFor(locale, '/faq')}>{t.home.faqAll} →</a>
      </header>
      <div class="faq-list">
        {t.faq.items.slice(0, 3).map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta" data-reveal>
    <h2>{t.home.ctaTitle}</h2>
    <p>{t.home.ctaText}</p>
    <div class="actions">
      <a class="button" href={pathFor(locale, '/visit')}>{t.home.ctaPrimary}</a>
      <a class="button ghost" href={pathFor(locale, '/analyze')}>{t.home.ctaSecondary}</a>
    </div>
  </section>
  <Support client:load locale={locale} />
  </div>
</Base>

<style is:global>
  .print-home .step em,
  .print-home .angle b {
    font-family: Unbounded, sans-serif;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .print-home .angle {
    color: var(--ink);
  }
  .print-home .angle em {
    color: var(--accent-deep);
  }
  .print-home .angle strong {
    color: var(--ink);
  }
  .print-home .angle b {
    background-image: none;
    -webkit-text-fill-color: currentColor;
  }
  .print-home .hero {
    position: relative;
    display: block;
    min-height: 520px;
    margin-top: 8px;
    overflow: visible;
  }
  .print-home .hero-copy {
    position: relative;
    z-index: 2;
    width: min(100%, 42rem);
    overflow: visible;
  }
  .print-home .hero h1 {
    width: max-content;
    max-width: min(8em, 100%);
    overflow: visible;
  }
  .print-home .hero .lead,
  .print-home .hero .proof,
  .print-home .hero-copy .meter {
    max-width: 28rem;
  }
  .print-home .hero-visual {
    position: absolute;
    z-index: 0;
    top: -20px;
    right: calc(50% - 50vw);
    width: min(74vw, 1080px);
    aspect-ratio: 16 / 9;
    height: auto;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 36%, #000 100%),
      linear-gradient(180deg, #000 0%, #000 72%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 36%, #000 100%),
      linear-gradient(180deg, #000 0%, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .print-home .hero-source {
    position: fixed;
    left: -9999px;
    top: 0;
    width: 320px;
    height: 180px;
    opacity: 0;
    pointer-events: none;
  }
  .print-home .step em {
    background-image: repeating-linear-gradient(
      180deg,
      var(--ink) 0 2px,
      transparent 2px 4px
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .print-home .kicker,
  .print-home .hero .lead,
  .print-home .hero .proof {
    color: var(--muted);
  }
  .print-home .hero-plate {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: transparent;
    object-fit: cover;
    object-position: center 42%;
    pointer-events: none;
    transform-origin: 70% 46%;
    animation: plate-drift 18s ease-in-out infinite alternate;
  }
  @keyframes plate-drift {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .print-home .hero-plate { animation: none; }
  }
  @media (max-width: 860px) {
    .print-home .hero-copy {
      width: 100%;
    }
    .print-home .hero {
      min-height: 0;
    }
    .print-home .hero-visual {
      position: relative;
      top: auto;
      right: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      margin-top: 18px;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    }
    .print-home .hero-plate {
      object-position: center 42%;
      animation: none;
    }
  }
  .print-home .step,
  .print-home .angle,
  .print-home .benefit {
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--line);
    background: var(--card);
  }
  .print-home .benefit {
    padding: 22px 22px 24px;
  }
  .print-home .benefit-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    animation: none;
    color: var(--ink);
  }
  .print-home .step em {
    font-size: 42px;
    line-height: 0.9;
  }
  .print-home .angle b { font-size: 40px; }
</style>
