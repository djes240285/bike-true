---
import '../styles/global.css';
import '@fontsource-variable/inter';
import AppChrome from '../components/AppChrome.astro';
import PwaHead from '../components/PwaHead.astro';
import AuthCorner from '../components/AuthCorner';
import ThemeSwitch from '../components/ThemeSwitch';
import { dict, type Locale } from '../i18n';
import { otherLocale, pathFor } from '../lib/paths';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = dict[locale];
const other = otherLocale(locale);
const links = [
  ['/how-to-shoot', t.nav.how],
  ['/analyze', t.nav.analyze],
  ['/visit', t.nav.visit],
  ['/about', t.nav.about],
  ['/faq', t.nav.faq],
] as const;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <PwaHead />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <script is:inline>
      try {
        if (localStorage.getItem('bt_theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
      document.documentElement.classList.add('js');
      if (matchMedia('(display-mode: standalone)').matches || navigator.standalone) {
        document.documentElement.classList.add('standalone');
      }
    </script>
  </head>
  <body>
    <div class="page-wheel" id="page-wheel" role="status">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <circle class="wheel-tire" cx="32" cy="32" r="26"></circle>
        <circle class="wheel-hub" cx="32" cy="32" r="4"></circle>
        <path class="wheel-spokes" d="M32 8v18M32 38v18M8 32h18M38 32h18M14 14l13 13M37 37l13 13M50 14L37 27M27 37L14 50"></path>
      </svg>
      <span class="sr-only">{locale === 'ru' ? 'Загрузка' : 'Loading'}</span>
    </div>
    <header class="top">
      <div class="top-bar">
        <a class="brand" href={pathFor(locale, '/')}>
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 512 512" aria-hidden="true">
            <circle cx="256" cy="256" r="232" fill="#1c1917"></circle>
            <g fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="153" cy="316" r="76" stroke="#d97706" stroke-width="12"></circle>
              <circle cx="359" cy="316" r="76" stroke="#f3efe6" stroke-width="12"></circle>
              <g stroke="#f3efe6" stroke-width="14">
                <path d="M153 316 215 214 253 316 153 316"></path>
                <path d="M215 214 296 214 253 316"></path>
                <path d="M296 214 359 316"></path>
                <path d="M201 193h29"></path>
                <path d="M288 197h28"></path>
                <path d="M215 193v21"></path>
                <path d="M296 197v17"></path>
              </g>
              <circle cx="253" cy="316" r="10" fill="#f3efe6" stroke="none"></circle>
            </g>
          </svg>
          {t.brand}
        </a>
        <nav class="nav">
          {links.map(([href, label]) => (
            <a href={pathFor(locale, href)} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="corner">
          <AuthCorner client:load locale={locale} />
          <a class="switch" href={pathFor(other, path)}>{t.switchLabel}</a>
          <ThemeSwitch client:only="react" locale={locale} />
        </div>
      </div>
    </header>
    <div class="shell">
      <main>
        <slot />
      </main>
      <footer>
        <p>{t.footer}</p>
        <a href={pathFor(locale, '/privacy')}>{t.privacy.title}</a>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var wheel = document.getElementById('page-wheel');
        var at = Date.now();
        function hide() {
          var wait = Math.max(0, 520 - (Date.now() - at));
          setTimeout(function () {
            if (wheel) wheel.classList.add('is-done');
          }, wait);
        }
        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide);
        document.addEventListener('click', function (event) {
          var node = event.target;
          var link = node && node.closest ? node.closest('a') : null;
          if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          if (link.origin !== location.origin) return;
          var url = new URL(link.href);
          if (url.pathname === location.pathname && url.search === location.search) return;
          at = Date.now();
          if (wheel) wheel.classList.remove('is-done');
        });
      })();
    </script>
    <script>
      const blocks = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        blocks.forEach((block) => observer.observe(block));
      } else {
        blocks.forEach((block) => block.classList.add('is-in'));
      }
    </script>
    <AppChrome locale={locale} />
  </body>
</html>
