---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<video
  class="motion"
  poster="/motion/how-to-shoot.jpg"
  preload="none"
  muted
  loop
  playsinline
  aria-label={label}
  data-src="/motion/how-to-shoot.mp4"
></video>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const attach = () => {
    if (reduce) return;
    document.querySelectorAll('.motion').forEach((node) => {
      if (!(node instanceof HTMLVideoElement)) return;
      const src = node.dataset.src;
      if (!src || node.currentSrc) return;
      node.src = src;
      node.play().catch(() => {});
    });
  };

  const whenIdle = () => {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(attach, { timeout: 2000 });
      return;
    }
    attach();
  };

  if (document.readyState === 'complete') whenIdle();
  else addEventListener('load', whenIdle, { once: true });
</script>
