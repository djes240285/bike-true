---
import type { Dict } from '../i18n';

interface Props {
  how: Dict['how'];
  nextHref: string;
}
const { how, nextHref } = Astro.props;
const [whole, light, alone] = how.frame.checks;
---

<ol class="guide">
  <li class="guide-camera">
    <img src="/motion/steps/camera.jpg" alt="" width="960" height="540" loading="lazy" decoding="async" />
    <div class="guide-copy">
      <span class="n" aria-hidden="true">1</span>
      <h2>{how.camera.title}</h2>
      <p>{how.camera.text}</p>
    </div>
  </li>

  <li class="guide-frame">
    <div class="guide-copy">
      <span class="n" aria-hidden="true">2</span>
      <h2>{how.frame.title}</h2>
    </div>
    <ol class="guide-checks">
      <li>
        <img src="/motion/steps/whole.jpg" alt="" width="960" height="540" loading="lazy" decoding="async" />
        <strong>{whole.title}</strong>
        <p>{whole.text}</p>
      </li>
      <li>
        <img src="/motion/steps/light.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{light.title}</strong>
        <p>{light.text}</p>
      </li>
      <li>
        <img src="/motion/steps/alone.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{alone.title}</strong>
        <p>{alone.text}</p>
      </li>
    </ol>
  </li>

  <li class="guide-shots">
    <div class="guide-copy">
      <span class="n" aria-hidden="true">3</span>
      <h2>{how.shots.title}</h2>
    </div>
    <div class="guide-pair">
      <article>
        <img src="/motion/steps/down.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{how.shots.down.title}</strong>
        <p>{how.shots.down.text}</p>
      </article>
      <article>
        <img src="/motion/steps/up.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{how.shots.up.title}</strong>
        <p>{how.shots.up.text}</p>
      </article>
    </div>
  </li>
</ol>
<p class="guide-next"><a class="button" href={nextHref}>{how.next}</a></p>
