---
import type { Dict } from '../i18n';

interface Props {
  how: Dict['how'];
  nextHref: string;
}
const { how, nextHref } = Astro.props;
---

<ol class="guide">
  <li>
    <div class="guide-copy">
      <span class="n" aria-hidden="true">1</span>
      <h2>{how.camera.title}</h2>
      <p>{how.camera.text}</p>
    </div>
  </li>

  <li>
    <div class="guide-copy">
      <span class="n" aria-hidden="true">2</span>
      <h2>{how.frame.title}</h2>
      <ul class="guide-checks">
        {how.frame.checks.map((check) => (
          <li>
            <strong>{check.title}</strong>
            <p>{check.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </li>

  <li class="guide-shots">
    <div class="guide-copy">
      <span class="n" aria-hidden="true">3</span>
      <h2>{how.shots.title}</h2>
    </div>
    <div class="guide-pair">
      <article>
        <img src="/motion/steps/down.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{how.shots.down.title}</strong>
        <p>{how.shots.down.text}</p>
      </article>
      <article>
        <img src="/motion/steps/up.jpg" alt="" width="960" height="720" loading="lazy" decoding="async" />
        <strong>{how.shots.up.title}</strong>
        <p>{how.shots.up.text}</p>
      </article>
    </div>
  </li>
</ol>
<p class="guide-next"><a class="button" href={nextHref}>{how.next}</a></p>
