---
import Analyzer from '../../components/Analyzer';
import AngleCue from '../../components/AngleCue.astro';
import Simple from '../../views/Simple.astro';
import { dict } from '../../i18n';
const t = dict.en;
---
<Simple locale="en" path="/analyze" title={t.analyze.title}>
  <p class="lead">{t.analyze.lead}</p>
  <AngleCue label="knee" />
  <Analyzer client:only="react" locale="en" />
</Simple>
