---
import Analyzer from '../components/Analyzer';
import Simple from '../views/Simple.astro';
import { dict } from '../i18n';
const t = dict.ru;
---
<Simple locale="ru" path="/analyze" title={t.analyze.title}>
  <p class="lead">{t.analyze.lead}</p>
  <Analyzer client:only="react" locale="ru" />
</Simple>
