---
import Film from '../components/Film.astro';
import ShootSteps from '../components/ShootSteps.astro';
import Simple from '../views/Simple.astro';
import { dict } from '../i18n';
import { pathFor } from '../lib/paths';
const t = dict.ru;
---
<Simple locale="ru" path="/how-to-shoot" title={t.how.title}>
  <p class="lead">{t.how.lead}</p>
  <Film label={t.how.film} />
  <ShootSteps how={t.how} nextHref={pathFor('ru', '/analyze')} />
</Simple>
