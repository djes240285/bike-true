# Серверные переменные Netlify. Меняются без правки кода.
# Общий пароль страницы входа. Пока пусто, на Netlify сайт никого не пускает.
SITE_PASSWORD=
# Флаг оплаты: true показывает цену и ссылку кассы. По умолчанию всё бесплатно.
PAYMENTS_ENABLED=false
PRICE_RUB=
CHECKOUT_URL=
CITY=
DURATION_MIN=
ADDRESS=
# Бот: в Telegram открой @BotFather, команда /newbot, скопируй токен.
# Чат: создай группу, добавь бота, напиши туда любое слово.
# Потом открой https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьми chat.id
# (у группы id отрицательный). Те же два значения потом вставишь в Netlify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
