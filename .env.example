# Серверные переменные Netlify. Меняются без правки кода.
# Общий пароль страницы входа. Пока пусто, на Netlify сайт никого не пускает.
SITE_PASSWORD=
# Флаг оплаты: true показывает цену и ссылку кассы. По умолчанию всё бесплатно.
PAYMENTS_ENABLED=false
PRICE_RUB=
CHECKOUT_URL=
# Разовая поддержка на главной. Ссылка ЮKassa, CloudTips или счёта.
# Сумма дописывается параметром amount. Пусто — кнопка не ведёт на оплату.
PUBLIC_SUPPORT_URL=
CITY=
DURATION_MIN=
ADDRESS=
# Бот: в Telegram открой @BotFather, команда /newbot, скопируй токен.
# Чат: создай группу, добавь бота, напиши туда любое слово.
# Потом открой https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьми chat.id
# (у группы id отрицательный). Те же два значения потом вставишь в Netlify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
WEB_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:8787
PUBLIC_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
# ИИ-проверка кадра: gemini или openai. Пусто — кнопки «Проверить кадр ИИ» нет.
AI_PROVIDER=
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini со зрением. Пусто — модель по умолчанию из кода.
GEMINI_MODEL=
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=
